---
import { FACILITY_LIST } from '../data/facilities';
---

<header class="sticky top-0 z-40 w-full bg-holiday-pine/95 backdrop-blur-md border-b border-holiday-gold/30 shadow-md text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      
      {/* Brand & Crest */}
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-holiday-pinedark to-holiday-pinelight border border-holiday-gold/60 flex items-center justify-center shadow-md">
          <svg class="w-5 h-5 text-holiday-gold" viewBox="0 0 100 100" fill="currentColor">
            <polygon points="50,15 35,35 43,35 28,55 38,55 20,78 80,78 62,55 72,55 57,35 65,35" fill="#D4AF37" />
            <circle cx="50" cy="53" r="7" fill="#C41E3A" />
            <polygon points="50,8 52,14 58,14 53,18 55,24 50,20 45,24 47,18 42,14 48,14" fill="#FFF" />
          </svg>
        </div>
        <div>
          <span class="block font-heading font-extrabold text-sm sm:text-base tracking-tight text-white group-hover:text-holiday-gold transition">
            FOURSQUARE HEALTHCARE
          </span>
          <span class="block text-[10px] font-semibold tracking-wider text-holiday-gold uppercase">
            Christmas Photo Tour 2026
          </span>
        </div>
      </a>

      {/* Clean Quick Links & Facility Selector */}
      <div class="flex items-center gap-2.5 sm:gap-4 text-xs font-semibold">
        {/* Quick Facility Dropdown */}
        <div class="relative group">
          <button
            type="button"
            class="px-2.5 py-1.5 bg-white/10 hover:bg-white/20 border border-holiday-gold/40 text-holiday-gold rounded-lg flex items-center gap-1 transition text-xs"
          >
            <span>Facilities (13 Dates)</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div class="absolute right-0 mt-1 w-64 bg-slate-900 border border-holiday-gold/40 rounded-xl shadow-2xl p-2 hidden group-hover:block z-50 divide-y divide-slate-800 max-h-96 overflow-y-auto">
            <div class="py-1">
              <span class="px-2 text-[10px] font-bold text-holiday-gold uppercase tracking-wider block mb-1">
                Select Facility Page
              </span>
              {FACILITY_LIST.map((fac) => (
                <a
                  href={`/${fac.code}`}
                  class="flex items-center justify-between px-2 py-1.5 rounded-lg text-slate-200 hover:bg-holiday-pine hover:text-white transition text-xs"
                >
                  <span class="truncate">{fac.name}</span>
                  <span class="font-mono text-[10px] text-holiday-gold shrink-0 ml-2">{fac.shortDate}</span>
                </a>
              ))}
              <a
                href="/cml-day2"
                class="flex items-center justify-between px-2 py-1.5 rounded-lg text-slate-200 hover:bg-holiday-pine hover:text-white transition text-xs"
              >
                <span class="truncate">Cheyenne (CML Day 2)</span>
                <span class="font-mono text-[10px] text-holiday-gold shrink-0 ml-2">11/10</span>
              </a>
            </div>
          </div>
        </div>

        <a href="/reschedule" class="text-white hover:text-holiday-gold transition hidden sm:inline">
          Reschedule Slot
        </a>

        <a
          href="/coordinator"
          class="px-3 py-1.5 bg-slate-900/90 hover:bg-slate-900 text-holiday-gold rounded-lg border border-slate-700 transition"
        >
          Staff Roster
        </a>
      </div>

    </div>
  </div>
</header>
