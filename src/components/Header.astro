---

<header class="sticky top-0 z-40 w-full bg-gradient-to-r from-holiday-velvet via-holiday-wine to-holiday-velvet backdrop-blur-md border-b border-holiday-gold/40 shadow-lg text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      
      {/* Brand & Crest */}
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-holiday-wine to-holiday-crimson border border-holiday-gold/70 flex items-center justify-center shadow-md">
          <svg class="w-5 h-5 text-holiday-gold" viewBox="0 0 100 100" fill="currentColor">
            <polygon points="50,15 35,35 43,35 28,55 38,55 20,78 80,78 62,55 72,55 57,35 65,35" fill="#D4AF37" />
            <circle cx="50" cy="53" r="7" fill="#BD162C" />
            <polygon points="50,8 52,14 58,14 53,18 55,24 50,20 45,24 47,18 42,14 48,14" fill="#FFF" />
          </svg>
        </div>
        <div>
          <span class="block font-heading font-extrabold text-sm sm:text-base tracking-tight text-white group-hover:text-holiday-gold transition">
            FOURSQUARE HEALTHCARE
          </span>
          <span class="block text-[10px] font-semibold tracking-wider text-holiday-gold uppercase font-serif">
            Christmas Photo Tour 2026
          </span>
        </div>
      </a>

      {/* Navigation Actions */}
      <div class="flex items-center gap-2.5 sm:gap-4 text-xs font-semibold">
        <a
          href="/reschedule"
          class="px-3.5 py-1.5 bg-gradient-to-r from-holiday-gold/20 to-holiday-gold/10 hover:from-holiday-gold/30 hover:to-holiday-gold/20 border border-holiday-gold/60 text-holiday-goldlight rounded-xl transition text-xs font-bold shadow-sm"
        >
          Reschedule Slot
        </a>
      </div>

    </div>
  </div>
</header>
