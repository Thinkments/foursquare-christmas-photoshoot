---
const currentYear = 2026;
const lastUpdated = "September 7, 2026";
---

<footer class="bg-holiday-slate text-slate-300 pt-16 pb-12 border-t-2 border-holiday-gold/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Grid of Bi-directional links */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pb-12 border-b border-slate-800">
      
      {/* Col 1: Brand & Purpose */}
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-xl bg-holiday-pine border border-holiday-gold/50 flex items-center justify-center">
            <span class="text-holiday-gold font-bold text-lg">4S</span>
          </div>
          <span class="font-heading font-extrabold text-white text-base">Foursquare Healthcare</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Annual Christmas Portrait Experience honoring front-line healthcare heroes, residents, and visiting families across North Texas hospital campuses.
        </p>
        <div class="text-[11px] text-slate-400 space-y-1">
          <p><strong class="text-slate-300">Edition:</strong> 2026 Holiday Schedule</p>
          <p><strong class="text-slate-300">Dual QDF Verified:</strong> Published Sep 7, 2026 • Updated Sep 7, 2026</p>
        </div>
      </div>

      {/* Col 2: Service Hubs */}
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-holiday-gold mb-3 font-heading">
          Portrait Sessions
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/services/staff-portraits" class="hover:text-holiday-gold transition">
              Staff & Shift Express Mini-Sessions
            </a>
          </li>
          <li>
            <a href="/services/resident-family" class="hover:text-holiday-gold transition">
              Resident & Multi-Gen Family Staging
            </a>
          </li>
          <li>
            <a href="/services/santa-experience" class="hover:text-holiday-gold transition">
              Santa Claus & North Pole Experience
            </a>
          </li>
          <li>
            <a href="/services/department-teams" class="hover:text-holiday-gold transition">
              Clinical Unit & Department Greeting Cards
            </a>
          </li>
          <li>
            <a href="/schedule" class="text-holiday-red hover:underline font-semibold">
              → Open Interactive Session Scheduler
            </a>
          </li>
        </ul>
      </div>

      {/* Col 3: DFW Studio Campuses */}
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-holiday-gold mb-3 font-heading">
          DFW Campus Studios
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/locations/dallas-regional" class="hover:text-holiday-gold transition">
              Dallas Regional Medical Center (Mesquite)
            </a>
          </li>
          <li>
            <a href="/locations/fort-worth-senior-living" class="hover:text-holiday-gold transition">
              Fort Worth Senior Living & Rehab
            </a>
          </li>
          <li>
            <a href="/locations/plano-specialty" class="hover:text-holiday-gold transition">
              Plano Specialty Hospital Campus
            </a>
          </li>
          <li>
            <a href="/locations/arlington-pavilion" class="hover:text-holiday-gold transition">
              Arlington Emergency Pavilion & Clinic
            </a>
          </li>
        </ul>
      </div>

      {/* Col 4: Interactive Tools & E-E-A-T */}
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-holiday-gold mb-3 font-heading">
          Client Tools & Guidelines
        </h4>
        <ul class="space-y-2 text-xs mb-4">
          <li>
            <a href="/reschedule" class="text-holiday-gold hover:underline font-semibold">
              Self-Service Reschedule Portal
            </a>
          </li>
          <li>
            <a href="/coordinator" class="text-white hover:text-holiday-gold font-semibold">
              Activity Coordinator Live Roster
            </a>
          </li>
          <li>
            <a href="/calculator" class="hover:text-holiday-gold transition">
              Holiday Package & Card Calculator
            </a>
          </li>
          <li>
            <a href="/style-guide" class="hover:text-holiday-gold transition">
              Wardrobe & Studio Backdrop Matcher
            </a>
          </li>
          <li>
            <a href="/prep-checklist" class="hover:text-holiday-gold transition">
              Prep & Accessibility Checklist
            </a>
          </li>
        </ul>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-[11px] text-slate-400">
          <span class="text-holiday-gold font-semibold block mb-1">Texas HHS Compliant:</span>
          Medical-grade HEPA studio air filtration and UV-C prop sanitization protocol active.
        </div>
      </div>

    </div>

    {/* Bottom Bar & Legal Disclaimer */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>
        © {currentYear} Foursquare Healthcare Network & Thinkments. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-[11px]">
        <span>Contact: holiday@foursquarehealthcare.com</span>
        <span>•</span>
        <span>Employee Concierge: (800) 555-4SQ-XMAS</span>
      </div>
    </div>
  </div>
</footer>
