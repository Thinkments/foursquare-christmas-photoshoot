---
import Layout from '../layouts/Layout.astro';
import FacilityScheduler from '../components/FacilityScheduler.tsx';
import { FOURSQUARE_FACILITIES } from '../data/facilities';

const facility = FOURSQUARE_FACILITIES.tray;
---

<Layout
  title={`${facility.name} (${facility.abbr}) Christmas Photo Shoot Scheduler | ${facility.shortDate}`}
  description={`Book your 5-minute holiday portrait with your resident loved one at ${facility.name} on ${facility.shootDate}. 10:00 AM - 7:00 PM rapid sessions with 1-click self-service rescheduling.`}
>
  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <FacilityScheduler client:load facilityCode="tray" />
  </div>
</Layout>
