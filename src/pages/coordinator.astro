---
import Layout from '../layouts/Layout.astro';
import CoordinatorRoster from '../components/CoordinatorRoster.tsx';
---

<Layout
  title="Neely's Coordinator Console & Facility Schedules | Foursquare Christmas 2026"
  description="Neely's backend access portal to view all 13 Foursquare facility schedules' status throughout the month."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-10 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Coordinator Backend Access • Neely's Operations Console
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold font-heading mt-1">
        Master Facility Schedules & Status
      </h1>
      <p class="text-xs sm:text-sm text-slate-200 mt-1 max-w-2xl mx-auto">
        Dedicated overview to track all 13 facility shoot schedules, care companion outreach status, guest counts, and resident bookings throughout the month.
      </p>
    </div>
  </div>

  <div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <CoordinatorRoster client:load />
  </div>
</Layout>
