---
import Layout from '../layouts/Layout.astro';
import CoordinatorRoster from '../components/CoordinatorRoster.tsx';
---

<Layout
  title="Care Companion Call Management & Roster | Foursquare Christmas 2026"
  description="Ongoing schedule access across all 13 Foursquare facility shoots. Department heads manage care companion outreach, track 5-minute photo slots, verify guest counts (max 4), and coordinate staff express sessions."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-10 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Department Head & Coordinator Operations Portal
      </span>
      <h1 class="text-2xl sm:text-4xl font-extrabold font-heading mt-1">
        Facility Schedules & Care Companion Call Center
      </h1>
      <p class="text-xs sm:text-sm text-slate-200 mt-1 max-w-2xl mx-auto">
        Ongoing access to each facility's 5-minute rapid shoot schedule. Manage department heads calling care companions, check-ins, guest counts (max 4), and staff sessions.
      </p>
    </div>
  </div>

  <div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <CoordinatorRoster client:load />
  </div>
</Layout>
