---
import Layout from '../layouts/Layout.astro';
import FacilityScheduler from '../components/FacilityScheduler.tsx';
import { FOURSQUARE_FACILITIES } from '../data/facilities';

const facility = FOURSQUARE_FACILITIES.cml;
---

<Layout
  title={`${facility.name} (${facility.abbr}) Christmas Photo Shoot Scheduler | 11/9 & 11/10`}
  description={`Book your 5-minute holiday portrait with your resident loved one at ${facility.name} on Monday, Nov 9 or Tuesday, Nov 10, 2026. 10:00 AM - 7:00 PM rapid sessions with 1-click self-service rescheduling.`}
>
  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <FacilityScheduler client:load facilityCode="cml" />
  </div>
</Layout>
