---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Santa Claus & North Pole Experience | Foursquare Christmas 2026"
  description="Personal, magical Santa Claus visits for healthcare employees’ children and visiting families. Zero mall lines, sanitized props, and instant high-res downloads."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-16 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Magical Family Memories
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading mt-2">
        Santa Claus & North Pole Visit
      </h1>
      <p class="text-sm sm:text-base text-slate-200 mt-2 max-w-2xl mx-auto">
        Skip crowded mall lines and bring your little ones to our private, hygienic North Pole workshop on campus.
      </p>
    </div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-red uppercase">Zero Wait Lines</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Scheduled Appointments</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          No standing in 90-minute lines with restless toddlers. Your dedicated 20-minute reservation starts the moment you arrive.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-pine uppercase">Clinical Cleanliness</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Sanitized Santa Suit</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Daily professional dry cleaning, steam sanitization between parties, and hand hygiene protocols standard.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-gold uppercase">North Pole Staging</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Toy Workshop Set</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Festive elves, wrapped gifts, candy cane decorations, and a red velvet throne for timeless childhood keepsakes.
        </p>
      </div>
    </div>

    <div class="bg-slate-900 text-white p-8 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6 border border-holiday-gold/30">
      <div>
        <h2 class="text-2xl font-bold font-heading">Bring the Magic Home</h2>
        <p class="text-xs text-slate-300 mt-1">Available at Arlington Emergency Pavilion and Fort Worth Senior Living campuses.</p>
      </div>
      <a
        href="/schedule"
        class="px-6 py-3.5 bg-holiday-red hover:bg-holiday-reddark text-white font-extrabold text-sm rounded-xl shadow-lg transition transform hover:scale-105 shrink-0"
      >
        Book Santa Visit Now →
      </a>
    </div>

    {/* Internal linking mesh */}
    <div class="pt-8 border-t border-slate-200 flex flex-wrap gap-3 text-xs">
      <span class="font-bold text-slate-700">Explore Related Pages:</span>
      <a href="/locations/arlington-pavilion" class="text-holiday-pine hover:underline">Arlington Santa Studio Suite</a> •
      <a href="/style-guide" class="text-holiday-pine hover:underline">Matching Holiday Pajama Ideas</a> •
      <a href="/prep-checklist" class="text-holiday-pine hover:underline">Toddler Prep Checklist</a> •
      <a href="/calculator" class="text-holiday-pine hover:underline">Foil Greeting Card Packages</a>
    </div>
  </div>
</Layout>
