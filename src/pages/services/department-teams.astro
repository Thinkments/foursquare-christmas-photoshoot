---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Unit & Department Team Holiday Cards | Foursquare Christmas 2026"
  description="Wide-angle group portrait sessions for hospital units, clinical departments, ICU/ER shifts, and administration teams. Create cohesive holiday cards and department recognitions."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-16 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Clinical Unit Team Camaraderie
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading mt-2">
        Unit & Department Team Holiday Cards
      </h1>
      <p class="text-sm sm:text-base text-slate-200 mt-2 max-w-2xl mx-auto">
        Commemorate a year of healthcare dedication with wide-angle team staging and custom greeting card design templates.
      </p>
    </div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-amber-700 uppercase">Large Group Poses</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Up to 25 Team Members</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Wide-format panoramic studio staging accommodating whole nursing shifts, therapy departments, and clinical leadership.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-pine uppercase">Shift Crossover</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Scheduled at Handoffs</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Sessions timed at 7:00 AM, 12:00 PM, and 7:00 PM so day and night shift crews can unite for a collective holiday photo.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-red uppercase">Custom Card Design</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Digital Card Template</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Includes a pre-formatted digital greeting card layout featuring your hospital name, unit title, and team holiday message.
        </p>
      </div>
    </div>

    <div class="bg-slate-900 text-white p-8 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6 border border-holiday-gold/30">
      <div>
        <h2 class="text-2xl font-bold font-heading">Schedule Your Department Group Shoot</h2>
        <p class="text-xs text-slate-300 mt-1">Select the Unit & Department Team option in our scheduler.</p>
      </div>
      <a
        href="/schedule"
        class="px-6 py-3.5 bg-holiday-red hover:bg-holiday-reddark text-white font-extrabold text-sm rounded-xl shadow-lg transition transform hover:scale-105 shrink-0"
      >
        Book Department Block →
      </a>
    </div>

    {/* Internal linking mesh */}
    <div class="pt-8 border-t border-slate-200 flex flex-wrap gap-3 text-xs">
      <span class="font-bold text-slate-700">Explore Related Pages:</span>
      <a href="/services/staff-portraits" class="text-holiday-pine hover:underline">Individual Staff Express Sessions</a> •
      <a href="/style-guide" class="text-holiday-pine hover:underline">Unit Matching Scrub Guide</a> •
      <a href="/calculator" class="text-holiday-pine hover:underline">Foil Greeting Card Calculator</a> •
      <a href="/locations/plano-specialty" class="text-holiday-pine hover:underline">Plano Winter Garden Atrium</a>
    </div>
  </div>
</Layout>
