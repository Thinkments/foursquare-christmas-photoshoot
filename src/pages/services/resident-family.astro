---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Resident & Multi-Gen Family Holiday Portraits | Foursquare Christmas 2026"
  description="Dignified, peaceful, 100% ADA-accessible holiday portrait sessions for senior living residents, rehab patients, and visiting multi-generational families."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-16 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Dignity, Comfort & Accessibility
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading mt-2">
        Resident & Multi-Gen Family Portraits
      </h1>
      <p class="text-sm sm:text-base text-slate-200 mt-2 max-w-2xl mx-auto">
        Cherished holiday moments captured with unrushed care, wheelchair-level staging, and gentle family assistance.
      </p>
    </div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-blue-700 uppercase">Accessibility First</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Zero-Threshold Entry</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Wide studio doorways (36"+) designed for bariatric wheelchairs, mobility scooters, and walkers with zero raised thresholds.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-pine uppercase">Unrushed Pacing</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">30-Minute Blocks</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Generous time buffers allow elderly residents to rest between poses without stress or feeling hurried.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-extrabold text-holiday-red uppercase">Comfort & Warmth</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Fireside Hearth</h3>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Staged in front of our warm brick hearth with comfortable padded armchairs, festive blankets, and gentle softbox lighting.
        </p>
      </div>
    </div>

    <div class="bg-slate-900 text-white p-8 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6 border border-holiday-gold/30">
      <div>
        <h2 class="text-2xl font-bold font-heading">Book a Peaceful Family Session</h2>
        <p class="text-xs text-slate-300 mt-1">Staged at Fort Worth Senior Living & Rehab and all campus studios.</p>
      </div>
      <a
        href="/schedule"
        class="px-6 py-3.5 bg-holiday-red hover:bg-holiday-reddark text-white font-extrabold text-sm rounded-xl shadow-lg transition transform hover:scale-105 shrink-0"
      >
        Schedule Family Session →
      </a>
    </div>

    {/* Internal linking mesh */}
    <div class="pt-8 border-t border-slate-200 flex flex-wrap gap-3 text-xs">
      <span class="font-bold text-slate-700">Explore Related Pages:</span>
      <a href="/locations/fort-worth-senior-living" class="text-holiday-pine hover:underline">Fort Worth Studio Details</a> •
      <a href="/prep-checklist" class="text-holiday-pine hover:underline">Mobility Preparation Checklist</a> •
      <a href="/style-guide" class="text-holiday-pine hover:underline">Family Wardrobe Harmony</a> •
      <a href="/calculator" class="text-holiday-pine hover:underline">Heirloom Canvas Calculator</a>
    </div>
  </div>
</Layout>
