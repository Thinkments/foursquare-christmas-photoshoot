---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Arlington Emergency Pavilion Holiday Studio | Foursquare Christmas 2026"
  description="Holiday portrait studio and Santa Claus experience at Arlington Emergency Pavilion & Urgent Care. Dec 12-14 in the Community Education Suite."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-16 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Emergency Pavilion & North Pole Hub
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading mt-2">
        Arlington Emergency Pavilion & Urgent Care
      </h1>
      <p class="text-sm sm:text-base text-slate-200 mt-2 max-w-2xl mx-auto">
        800 W Randol Mill Rd, Arlington, TX 76012 • Community Education & Santa Workshop Suite
      </p>
    </div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-red uppercase">Dates Active</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">December 12 – 14, 2026</h3>
        <p class="text-xs text-slate-600 mt-2">
          Featuring both Santa Claus Experience slots and 24/7 ER clinical unit group photography.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-pine uppercase">Santa Workshop Set</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">North Pole Suite</h3>
        <p class="text-xs text-slate-600 mt-2">
          Sanitized velvet throne, toy workshop staging, and festive treats for staff children.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-gold uppercase">Place ID</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Google Place Verified</h3>
        <p class="text-xs text-slate-600 mt-2">
          <code>ChIJzQ1Y7r2UTYYR1vE9m4P2Z8Q</code> • Dedicated Community Entrance parking bays.
        </p>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-lg">
      <h2 class="text-xl font-bold font-heading text-slate-900 mb-4">24/7 ER & Urgent Care Shift Staging</h2>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        Our emergency staff work round the clock protecting our communities. We offer early morning 6:30 AM and late evening 8:00 PM session blocks specifically designed for acute care doctors, trauma nurses, and EMS personnel.
      </p>
      <a
        href="/schedule"
        class="inline-flex items-center gap-2 px-6 py-3.5 bg-holiday-pine hover:bg-holiday-pinelight text-holiday-gold font-bold text-sm rounded-xl shadow-md transition"
      >
        <span>Schedule Slot at Arlington Pavilion</span> →
      </a>
    </div>

    {/* Internal linking mesh */}
    <div class="pt-8 border-t border-slate-200 flex flex-wrap gap-3 text-xs">
      <span class="font-bold text-slate-700">Other DFW Studios:</span>
      <a href="/locations/dallas-regional" class="text-holiday-pine hover:underline">Dallas Regional Medical Center</a> •
      <a href="/locations/fort-worth-senior-living" class="text-holiday-pine hover:underline">Fort Worth Senior Living</a> •
      <a href="/locations/plano-specialty" class="text-holiday-pine hover:underline">Plano Specialty Hospital</a> •
      <a href="/services/santa-experience" class="text-holiday-pine hover:underline">Santa Experience Details</a>
    </div>
  </div>
</Layout>
