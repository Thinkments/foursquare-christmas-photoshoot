---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Fort Worth Senior Living & Rehab Studio | Foursquare Christmas 2026"
  description="Holiday portrait studio at Fort Worth Senior Living & Rehabilitation Center. Dec 5-7 in the Fireside Grand Hearth Lounge. 100% wheelchair accessible."
>
  <div class="bg-gradient-to-b from-holiday-pinedark to-holiday-pine text-white py-16 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs uppercase font-extrabold text-holiday-gold tracking-widest">
        Senior Living & Rehabilitation
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading mt-2">
        Fort Worth Senior Living & Rehab
      </h1>
      <p class="text-sm sm:text-base text-slate-200 mt-2 max-w-2xl mx-auto">
        2800 W 7th St, Fort Worth, TX 76107 • Fireside Grand Hearth Lounge
      </p>
    </div>
  </div>

  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-red uppercase">Dates Active</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">December 5 – 7, 2026</h3>
        <p class="text-xs text-slate-600 mt-2">
          Daily from 9:00 AM to 6:00 PM with quiet sensory slots preserved from 10:30 AM – 11:30 AM.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-pine uppercase">Accessibility</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Universal Entry</h3>
        <p class="text-xs text-slate-600 mt-2">
          Flat zero-threshold thresholds, motorized chair turning radius, and transfer assist benches.
        </p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-md">
        <span class="text-xs font-bold text-holiday-gold uppercase">Place ID</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Google Place Verified</h3>
        <p class="text-xs text-slate-600 mt-2">
          <code>ChIJg22Z16-GTYYR2xUv1vE8m6Q</code> • Valet and handicap visitor parking at main portico.
        </p>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-lg">
      <h2 class="text-xl font-bold font-heading text-slate-900 mb-4">Multi-Generational Family Welcome</h2>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        We warmly welcome children, grandchildren, and certified therapy companions. Our photography staff is experienced in memory care interactions and ensures a soothing, joyous atmosphere.
      </p>
      <a
        href="/schedule"
        class="inline-flex items-center gap-2 px-6 py-3.5 bg-holiday-pine hover:bg-holiday-pinelight text-holiday-gold font-bold text-sm rounded-xl shadow-md transition"
      >
        <span>Schedule Slot at Fort Worth</span> →
      </a>
    </div>

    {/* Internal linking mesh */}
    <div class="pt-8 border-t border-slate-200 flex flex-wrap gap-3 text-xs">
      <span class="font-bold text-slate-700">Other DFW Studios:</span>
      <a href="/locations/dallas-regional" class="text-holiday-pine hover:underline">Dallas Regional Medical Center</a> •
      <a href="/locations/plano-specialty" class="text-holiday-pine hover:underline">Plano Specialty Hospital</a> •
      <a href="/locations/arlington-pavilion" class="text-holiday-pine hover:underline">Arlington Emergency Pavilion</a> •
      <a href="/services/resident-family" class="text-holiday-pine hover:underline">Resident Family Staging Guide</a>
    </div>
  </div>
</Layout>
