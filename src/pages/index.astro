---
import Layout from '../layouts/Layout.astro';
import FacilityScheduler from '../components/FacilityScheduler.tsx';
import { FACILITY_LIST } from '../data/facilities';
---

<Layout
  title="Foursquare Healthcare Christmas Photo Shoot Scheduler | 13 Facility Dates"
  description="Official Christmas portrait scheduler across all 13 Foursquare Healthcare facility shoot dates (11/5 - 12/9). 5-minute rapid slots, 12pm dept head group photo block, and 1-click self-service rescheduling."
>
  {/* Header */}
  <div class="flyer-crimson-gradient text-white pt-10 pb-16 px-4 text-center border-b-2 border-holiday-gold/40 relative overflow-hidden shadow-2xl">
    {/* Subtle festive bokeh glow overlays */}
    <div class="absolute -top-20 -left-20 w-72 h-72 rounded-full bg-holiday-gold/15 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 rounded-full bg-holiday-redlight/20 blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      {/* Flyer Badge */}
      <span class="inline-block text-[11px] uppercase font-extrabold text-holiday-goldlight tracking-widest bg-black/30 backdrop-blur-sm px-4 py-1.5 rounded-full border border-holiday-gold/50 mb-3 shadow-sm">
        ✨ Spots are Limited • Reserve Your Time Slot Online Today
      </span>

      {/* Script Calligraphy Accent from Flyer */}
      <div class="font-script text-4xl sm:text-6xl text-holiday-goldlight tracking-wide drop-shadow-md py-1">
        Family Portraits
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold font-heading text-white tracking-tight mt-1">
        Christmas Photoshoot Scheduler
      </h1>

      <p class="font-serif italic text-sm sm:text-base text-holiday-goldlight/90 mt-1.5 font-medium tracking-wide">
        Capture The Joy Of The Season
      </p>

      <p class="text-xs sm:text-sm text-rose-100/90 mt-3 max-w-2xl mx-auto leading-relaxed">
        Welcome to the official Foursquare Christmas Photoshoot! Please note that <strong>only 1 timeslot is permitted per resident</strong>, and there is a <strong>maximum of 4 guests per photo group</strong>.
      </p>

      {/* Operational Rules Bar matching the flyer gold/crimson badges */}
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 mt-6 text-xs text-rose-100">
        <div class="flex items-center gap-1.5 bg-black/30 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-holiday-gold/40 shadow-sm">
          <span class="text-holiday-gold font-bold">★</span> 5-Minute Timeslots (10am – 7pm)
        </div>
        <div class="flex items-center gap-1.5 bg-black/30 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-holiday-gold/40 shadow-sm">
          <span class="text-holiday-gold font-bold">★</span> Limit 1 Timeslot Per Resident
        </div>
        <div class="flex items-center gap-1.5 bg-black/30 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-holiday-gold/40 shadow-sm">
          <span class="text-holiday-gold font-bold">★</span> Max 4 Guests Per Group
        </div>
        <div class="flex items-center gap-1.5 bg-black/30 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-holiday-gold/40 shadow-sm">
          <span class="text-holiday-gold font-bold">★</span> 1-Click Self Rescheduling
        </div>
      </div>
    </div>
  </div>

  <div class="py-10 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    
    {/* 13 Facility Quick Directory Grid */}
    <div class="mb-12">
      <div class="text-center mb-6">
        <span class="text-xs uppercase font-extrabold text-holiday-crimson tracking-widest font-serif">
          13 Individual Facility Pages
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-slate-900 mt-1">
          Select Your Facility Schedule
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Click any facility below to open its dedicated 5-minute scheduler and day-of staff roster:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
        {FACILITY_LIST.map((fac) => (
          <a
            href={`/${fac.code}`}
            class="group bg-white hover:bg-rose-50/40 border border-slate-200 hover:border-holiday-crimson/50 rounded-2xl p-4 shadow-sm hover:shadow-md transition flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-extrabold text-white bg-gradient-to-r from-holiday-wine to-holiday-crimson px-2.5 py-0.5 rounded-lg shadow-xs">
                  {fac.abbr}
                </span>
                <span class="text-xs font-bold text-holiday-wine bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-full">
                  {fac.shortDate}
                </span>
              </div>
              <h3 class="font-heading font-bold text-slate-900 text-sm group-hover:text-holiday-crimson transition">
                {fac.name}
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5">{fac.city}</p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-serif italic">{fac.dayOfWeek}</span>
              <span class="text-holiday-crimson font-bold group-hover:translate-x-0.5 transition inline-flex items-center">
                Book Slot &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Featured / Active Facility Scheduler */}
    <div class="border-t border-slate-200 pt-10">
      <div class="text-center mb-6">
        <span class="text-xs uppercase font-extrabold text-holiday-crimson tracking-wider font-serif">
          Featured Facility Console
        </span>
        <h2 class="text-2xl font-bold font-heading text-slate-900 mt-1">
          Ashton Medical Lodge (AML • Dec 2)
        </h2>
        <p class="text-xs text-slate-500">
          Or navigate to any other facility above for their dedicated shoot console.
        </p>
      </div>

      <FacilityScheduler client:load facilityCode="aml" />
    </div>

    {/* Operational FAQ */}
    <div class="mt-14 max-w-4xl mx-auto border-t border-slate-200 pt-8">
      <h3 class="text-center font-bold text-slate-900 text-base font-heading mb-4">
        Christmas Photoshoot Guidelines
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-600">
        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">1 Timeslot Per Resident</strong>
          <span>To ensure every resident has an opportunity to participate, reservations are strictly limited to 1 timeslot per resident.</span>
        </div>

        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">Maximum 4 Guests</strong>
          <span>To keep 5-minute photo sessions running smoothly and comfortably in the holiday studio lounge, there is a maximum of 4 guests per photo group.</span>
        </div>

        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">Self-Service Rescheduling</strong>
          <span>Every confirmation includes a 1-click private reschedule link. Families can change slots without calling the reception desk.</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
