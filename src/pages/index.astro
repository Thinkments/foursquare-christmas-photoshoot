---
import Layout from '../layouts/Layout.astro';
import SimpleHolidayScheduler from '../components/SimpleHolidayScheduler.tsx';
---

<Layout
  title="Ashton Medical Lodge Christmas Photo Shoot Scheduler | Dec 2, 2026"
  description="Book your 10-minute Christmas portrait with your resident loved one at Ashton Medical Lodge on Dec 2nd. Automated SMS reminders and 1-click self-service rescheduling."
>
  {/* Simple & Elegant Festive Header */}
  <div class="bg-gradient-to-b from-holiday-pinedark via-holiday-pine to-holiday-pinedark text-white pt-10 pb-14 px-4 text-center border-b border-holiday-gold/30">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block text-xs uppercase font-extrabold text-holiday-gold tracking-widest bg-white/10 px-3.5 py-1 rounded-full border border-holiday-gold/40 mb-3">
        🎄 Ashton Medical Lodge • Dec 2, 2026
      </span>

      <h1 class="text-3xl sm:text-5xl font-extrabold font-heading text-white tracking-tight">
        Resident Family Photo Shoot Scheduler
      </h1>

      <p class="text-xs sm:text-sm text-slate-200 mt-2 max-w-xl mx-auto leading-relaxed">
        Book your 10-minute holiday portrait with your resident loved one at Ashton Medical Lodge on Wednesday, December 2nd. Replaces the receptionist paper sign-up sheet.
      </p>

      {/* 3 Simple Feature Highlights */}
      <div class="flex flex-wrap items-center justify-center gap-4 mt-6 text-xs text-slate-300">
        <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1 rounded-full border border-white/10">
          <span class="text-holiday-gold font-bold">✓</span> 10-Minute Rapid Slots
        </div>
        <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1 rounded-full border border-white/10">
          <span class="text-holiday-gold font-bold">✓</span> Automated SMS & Email Reminders
        </div>
        <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1 rounded-full border border-white/10">
          <span class="text-holiday-gold font-bold">✓</span> 1-Click Self-Service Rescheduling
        </div>
      </div>
    </div>
  </div>

  {/* Main Scheduler Area */}
  <div class="py-10 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <SimpleHolidayScheduler client:load />

    {/* 3-Question Simple FAQ */}
    <div class="mt-14 max-w-3xl mx-auto border-t border-slate-200 pt-8">
      <h3 class="text-center font-bold text-slate-900 text-base font-heading mb-4">
        Frequently Asked Questions
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-600">
        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">How long are photo sessions?</strong>
          <span>Sessions are scheduled in 10-minute back-to-back increments on Dec 2nd. Please arrive 5 minutes early in the Fireside Lounge.</span>
        </div>

        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">How do I change or reschedule?</strong>
          <span>Click the "Reschedule Slot" tab above or your reminder text. You can switch to any remaining open 10-minute slot in seconds.</span>
        </div>

        <div class="p-4 bg-white rounded-2xl border border-slate-200 shadow-sm">
          <strong class="text-slate-900 block mb-1">Are wheelchairs accommodated?</strong>
          <span>Yes! The Fireside Lounge has level entry, and our Activity Coordinator will ensure ramp and transfer assistance is ready for your loved one.</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
